# Frontend / dev-server settings. Copy to .env.local and adjust as needed.
# All values are optional; the defaults below are what `make frontend-run` uses.

# Base URL the browser calls. Keep it same-origin so the Vite/nginx proxy handles CORS.
VITE_API_BASE=/api

# Where the Vite dev server proxies /api to. Point this at the mock API or a remote backend.
VITE_DEV_API_TARGET=http://localhost:8080

# Ports for `npm run dev` / `npm run preview` and for the mock API.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
PORT=8080
